 "code": "// 토끼와 거북이 — 이야기 코드 (블록으로도 볼 수 있어요)\n// 길따라(길, 시작%, 끝%, 빠르기): 길의 처음이 0, 끝이 100\n\n쪽(\"책 속으로\");\n이야기.말하기(\"펑! 우리가 책 속으로 들어왔어요.\");\n이야기.말하기(\"여기는 「토끼와 거북이」 이야기 숲이에요.\");\n이야기.말하기(\"가고 싶은 곳의 땅을 누르면 걸어가요. 한번 걸어 볼까요?\");\n목표(\"부엉이 심판에게 가 보세요\", 부엉이);\n도착(부엉이, 3);\n부엉이.말하기(\"어서 와! 나는 숲속 달리기 심판, 부엉이야.\");\n부엉이.말하기(\"오늘 숲에 재미있는 일이 생길 것 같아.\");\n부엉이.말하기(\"저기 풀밭에 토끼와 거북이가 있어. 같이 가 볼래?\");\n\n쪽(\"놀리는 토끼\");\n목표(\"풀밭의 토끼와 거북이에게 가요\", 토끼);\n도착(토끼, 3);\n토끼.말하기(\"하하하! 거북아, 너는 왜 그렇게 느리니?\");\n토끼.말하기(\"엉금엉금, 엉금엉금~ 하루 종일 걸어도 언덕까지 못 가겠다!\");\n거북이.표정(\"😢\");\n거북이.말하기(\"……\");\n이야기.말하기(\"거북이는 고개를 푹 숙였어요.\");\nlet 마음 = 이야기.묻기(\"거북이 마음은 어떨까요?\", [\"😢 속상해요\", \"😄 신나요\", \"😐 아무렇지 않아요\"]);\nif (마음 == 1) {\n  이야기.말하기(\"맞아요. 친구가 놀리면 마음이 속상해요.\");\n} else {\n  이야기.말하기(\"음… 내가 놀림을 받으면 어떨까요? 거북이는 속상했을 거예요.\");\n}\nlet 말 = 이야기.묻기(\"거북이에게 어떤 말을 해 줄까요?\", [\"💬 괜찮아, 천천히 가도 돼!\", \"💬 힘내, 거북아!\", \"💬 토끼야, 친구를 놀리면 안 돼.\"]);\n나.말하기(고른말());\nif (말 == 3) {\n  토끼.말하기(\"흥… 그냥 장난이었어.\");\n}\n거북이.말하기(\"고마워. 네 말을 들으니 힘이 나.\");\n거북이.말하기(\"토끼야, 그럼 우리 달리기 시합을 해 보자!\");\n토끼.뛰기(1);\n토끼.말하기(\"나랑? 푸하하, 좋아! 언덕 위 결승선까지 누가 먼저 가나 보자!\");\n부엉이.말하기(\"좋아요! 내가 심판을 볼게요. 모두 출발선으로 오세요!\");\n\n쪽(\"출발선\");\n따로(() => 토끼.걷기(출발토끼, 3.5));\n따로(() => 거북이.걷기(출발거북이, 1.6));\n목표(\"출발선으로 가요 (빨간 줄)\", 출발선);\n도착(출발선, 3.4);\n부엉이.말하기(\"규칙은 간단해요. 언덕 위 결승선에 먼저 닿으면 이겨요.\");\n부엉이.말하기(\"출발 신호는 네가 해 줄래?\");\n부엉이.묻기(\"단추를 눌러 출발 신호를 보내요!\", [\"🚩 깃발 들기!\"]);\nfor (const 글자 of [\"셋\", \"둘\", \"하나\"]) {\n  번쩍(글자);\n  기다리기(0.9);\n}\n번쩍(\"출발!\");\n기다리기(0.5);\n\n쪽(\"깡충깡충, 엉금엉금\");\n따로(() => {\n  토끼.길따라(길, 0, 62, 9);\n  토끼.걷기(낮잠자리, 4);\n});\n따로(() => 거북이.길따라(길, 0, 24, 1.3));\n이야기.말하기(\"토끼는 깡충깡충 아주 빨리 달려갔어요.\");\n이야기.말하기(\"거북이는 엉금엉금 천천히 걸어갔어요.\");\n목표(\"토끼를 따라 큰 나무까지 가요\", 낮잠자리);\n도착(낮잠자리, 3.6);\n토끼.멈출때까지();\n토끼.말하기(\"헥헥, 뒤를 봐. 거북이는 아직 저~ 뒤에 있네!\");\n토끼.말하기(\"거북이는 한참 멀었어. 이 나무 그늘에서 한숨 자고 가야지.\");\n토끼.눕기();\n이야기.말하기(\"쿨쿨… 토끼는 그만 잠이 들었어요.\");\nlet 까닭 = 이야기.묻기(\"토끼는 왜 잠을 잤을까요?\", [\"🐢 거북이가 느리다고 얕봐서\", \"🍔 배가 고파서\", \"☔ 비가 와서\"]);\nif (까닭 == 1) {\n  이야기.말하기(\"맞아요. 토끼는 「나는 빠르니까 괜찮아」 하고 마음을 놓았어요.\");\n} else {\n  이야기.말하기(\"음… 토끼는 거북이가 느리다고 생각했어요. 그래서 마음 놓고 쉬었지요.\");\n}\nlet 깨우기 = 이야기.묻기(\"토끼를 깨워 볼까요?\", [\"👋 토끼야, 일어나!\", \"🤫 조용히 거북이에게 가 볼래요\"]);\nif (깨우기 == 1) {\n  토끼.말하기(\"음냐음냐… 딱 5분만…\");\n  이야기.말하기(\"토끼는 깊이 잠들었어요. 거북이에게 가 봐요.\");\n}\n\n쪽(\"개울 건너기\");\n목표(\"개울 앞의 거북이에게 가요\", 거북이);\n도착(거북이, 3.2);\n거북이.말하기(\"아이고, 개울이 나왔네. 물이 차가워 보여.\");\n거북이.말하기(\"징검돌을 하나씩 밟으면 건널 수 있어.\");\n거북이.말하기(\"내가 건널 수 있게 돌을 1번부터 차례대로 눌러 줄래?\");\nconst 세기 = [\"하나\", \"둘\", \"셋\", \"넷\", \"다섯\"];\nfor (let i = 1; i <= 5; i++) {\n  찾기(\"징검돌\" + i).이름표(i);\n}\nfor (let i = 1; i <= 5; i++) {\n  목표(i + \"번 징검돌을 눌러요\", 찾기(\"징검돌\" + i));\n  누를때까지(찾기(\"징검돌\" + i));\n  번쩍(세기[i - 1]);\n  찾기(\"징검돌\" + i).색(\"#ffe27a\");\n  거북이.걷기(찾기(\"징검돌\" + i), 2.2);\n}\n목표(\"\", null);\n거북이.걷기(개울건너, 2);\n거북이.말하기(\"한 걸음, 한 걸음! 천천히 가도 멈추지 않으면 돼.\");\nlet 어떻게 = 이야기.묻기(\"거북이는 어떻게 가고 있나요?\", [\"👣 쉬지 않고 꾸준히 가요\", \"🏠 힘들어서 집에 가요\"]);\nif (어떻게 == 1) {\n  이야기.말하기(\"맞아요! 거북이는 느리지만 멈추지 않아요.\");\n} else {\n  이야기.말하기(\"거북이는 힘들어도 포기하지 않았어요. 한 걸음씩 꾸준히 가요.\");\n}\n\n쪽(\"결승선\");\n따로(() => 거북이.길따라(길, 38, 90, 2.4));\n따로(() => 부엉이.날기(결승부엉이));\n이야기.말하기(\"거북이는 쉬지 않고 걸었어요. 영차, 영차!\");\n목표(\"거북이를 응원하며 결승선까지 가요\", 결승선);\n도착(결승선, 4);\n거북이.멈출때까지();\n카메라(토끼);\n기다리기(0.7);\n토끼.일어나기();\n토끼.말하기(\"하암~ 잘 잤다. …어? 거북이가 벌써 저기에?!\");\n토끼.말하기(\"안 돼! 빨리 달려야지!\");\n따로(() => 토끼.길따라(길, 62, 97, 7));\n카메라(결승선);\n거북이.길따라(길, 90, 100, 1.6);\n꽃가루(결승선);\n번쩍(\"거북이 승리!\");\n거북이.애니(\"깡충\");\n부엉이.말하기(\"거북이가 먼저 들어왔어요! 거북이 승리!\");\n토끼.멈출때까지();\n거북이.애니(\"자동\");\n따로(() => 거북이.걷기(결승거북이, 3));\n따로(() => 토끼.걷기(결승토끼, 3));\n나.걷기(결승나, 3);\n카메라(나);\n\n쪽(\"이야기가 남긴 마음\");\n토끼.말하기(\"헥헥… 거북아, 놀려서 미안해.\");\n토끼.말하기(\"나는 빠르다고 뽐내다가 쉬어 버렸어. 너는 한 번도 멈추지 않았구나.\");\n거북이.말하기(\"괜찮아, 토끼야. 다음에는 우리 같이 걷자!\");\nlet 배움 = 부엉이.묻기(\"이 이야기에서 무엇을 배웠나요?\", [\"🐢 느려도 꾸준히 하면 해낼 수 있어요\", \"🤝 친구를 놀리지 않아요\", \"🐇 빠르면 쉬어도 꼭 이겨요\"]);\nif (배움 == 1) {\n  부엉이.말하기(\"맞아요! 멈추지 않고 꾸준히 하는 힘이 거북이를 이기게 했어요.\");\n} else if (배움 == 2) {\n  부엉이.말하기(\"맞아요! 놀림은 친구 마음을 아프게 해요. 그리고 꾸준히 하는 힘도 배웠지요.\");\n} else {\n  부엉이.말하기(\"음, 토끼는 빨랐지만 쉬어서 졌어요. 꾸준히 하는 게 더 중요해요.\");\n}\nconst 할일 = [\"책 읽기를\", \"글씨 쓰기를\", \"줄넘기를\", \"정리 정돈을\"];\nlet 고른일 = 부엉이.묻기(\"나도 거북이처럼 꾸준히 해 볼 일을 골라 볼까요?\", [\"📚 책 읽기\", \"✏️ 글씨 쓰기\", \"🪢 줄넘기\", \"🧸 정리 정돈\"]);\n다짐(\"나는 매일 조금씩 \" + 할일[고른일 - 1] + \" 꾸준히 할 거예요.\");\n나.말하기(\"나는 매일 조금씩 \" + 할일[고른일 - 1] + \" 꾸준히 할 거예요!\");\n부엉이.말하기(\"멋진 다짐이에요! 매일 조금씩, 꾸준히!\");\n부엉이.말하기(\"오늘의 선물이야. 「꾸준함의 돌」과 「거북이 등딱지 스티커」!\");\n끝내기({ 포인트: 10, 돌: [\"꾸준함의 돌\"], 스티커: [\"거북이 등딱지\"] });\n"
}
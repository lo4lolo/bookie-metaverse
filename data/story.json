  "intro": [
    {
      "who": "",
      "text": "작은 돌 하나, 작은 만남 하나, 작은 하루 하나."
    },
    {
      "who": "",
      "text": "그것들이 쌓이면 하나의 마을이 되고, 하나의 이야기가 된다."
    },
    {
      "who": "",
      "text": "{name}은(는) 오늘 돌봄마을에 처음 도착했다. 광장 한가운데에 낮은 돌탑이 보인다."
    },
    {
      "who": "",
      "text": "먼저 돌탑 왼쪽 위 빨간 지붕 집 앞의 돌순 할머니에게 말을 걸어 보자. (말 걸기: 스페이스 / 탭)"
    }
  ],
  "quests": [
    {
      "id": "q_hello",
      "npc": "grandma",
      "title": "첫 인사",
      "desc": "마을 사람 다섯 명에게 인사하기 (보리 아저씨, 나리, 물결 삼촌, 단단이, 책방 선생님)",
      "need": {
        "type": "talk",
        "npcs": [
          "bori",
          "nari",
          "mulgyeol",
          "dandan",
          "chaek"
        ]
      },
      "reward": {
        "points": 5,
        "stone": "만남의 돌"
      },
      "offer": [
        "어서 오렴, {name}. 먼 길 오느라 수고했구나.",
        "이 마을 사람들은 저마다 작은 돌 하나씩을 품고 산단다.",
        "우선 마을 사람들에게 인사부터 해 보겠니? 다섯 명이란다."
      ],
      "progress": [
        "아직 인사하지 못한 사람이 있구나. 천천히 둘러보렴."
      ],
      "done": [
        "모두와 인사했구나! 첫 만남도 소중한 돌이 된단다.",
        "자, 이 '만남의 돌'을 돌탑에 올려 보렴."
      ],
      "talkLines": {
        "bori": "오, 새 얼굴이네! 나는 빵집 보리야. 반가워!",
        "nari": "안녕! 나는 나리야. 꽃 좋아해?",
        "mulgyeol": "허허, 계곡까지 왔구나. 난 물결이라고 한다.",
        "dandan": "나는 단단이! 반짝이는 돌을 찾고 있어.",
        "chaek": "반가워요. 이 마을의 이야기를 모으는 책방 선생님이랍니다."
      }
    },
